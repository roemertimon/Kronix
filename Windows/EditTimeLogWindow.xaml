<Window x:Class="Kronix.Windows.EditTimeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeiteintrag bearbeiten"
        Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <Border Background="White" CornerRadius="16" Padding="28"
            BorderBrush="#E5EAF0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#27364B" BlurRadius="24" ShadowDepth="5" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Zeiteintrag bearbeiten" FontSize="21"
                           FontWeight="SemiBold" Foreground="#1D2939"/>
                <TextBlock Text="Kundennummer und Zeiten anpassen"
                           FontSize="14" Foreground="#667085" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="Kundennummer" FontSize="13" FontWeight="SemiBold"
                           Foreground="#344054" Margin="0,0,0,6"/>
                <TextBox x:Name="ClientNumberTextBox" Height="40" Padding="11,0"
                         VerticalContentAlignment="Center" FontSize="15"
                         BorderBrush="#D0D5DD" BorderThickness="1"/>
                <TextBlock Text="Startzeit (TT.MM.JJJJ HH:MM)" FontSize="13"
                           FontWeight="SemiBold" Foreground="#344054"
                           Margin="0,15,0,6"/>
                <TextBox x:Name="StartTimeTextBox" Height="40" Padding="11,0"
                         VerticalContentAlignment="Center" FontSize="15"
                         BorderBrush="#D0D5DD" BorderThickness="1"/>
                <TextBlock Text="Endzeit (TT.MM.JJJJ HH:MM)" FontSize="13"
                           FontWeight="SemiBold" Foreground="#344054"
                           Margin="0,15,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EndTimeTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="15"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                    <Button Grid.Column="2" Content="Auf 5 Min. runden"
                            Height="40" Padding="12,0"
                            Background="#E9EEF4" Foreground="#20364F"
                            BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                            Click="RoundEndTimeButton_Click"/>
                </Grid>
                <TextBlock Text="Tätigkeit / Notiz" FontSize="13"
                           FontWeight="SemiBold" Foreground="#344054"
                           Margin="0,15,0,6"/>
                <TextBox x:Name="NotesTextBox" MinHeight="74" MaxHeight="120"
                         Padding="11,8" VerticalContentAlignment="Top"
                         TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"
                         BorderBrush="#D0D5DD" BorderThickness="1"/>
                <TextBlock x:Name="ErrorTextBlock" Foreground="#B42318"
                           FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Abbrechen" Width="112" Height="40"
                        Background="White" Foreground="#344054"
                        BorderBrush="#D0D5DD" BorderThickness="1"
                        FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button Content="Speichern" Width="112" Height="40"
                        Background="#20364F" Foreground="White"
                        BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
