<UserControl x:Class="Kronix.Windows.Zeiterfassung"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="1000">
    <UserControl.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#20364F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#087F5B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#DCE5EE"/>
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#CBD7E3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7F9FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Width="760" MaxWidth="760" HorizontalAlignment="Center"
                        Margin="28,22,28,0">
                <TextBlock Text="Zeiterfassung" FontSize="23" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}"/>
                <TextBlock Text="Arbeitszeit erfassen und verwalten" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Width="760" MaxWidth="760" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="28">
            <Border Background="White" CornerRadius="14" Padding="22"
                    BorderBrush="#E6EBF0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Kundennummer" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9"/>
                    <Grid Height="48">
                        <TextBox x:Name="CustomerNumberTextBox"
                                 Padding="14,0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Calibri" FontSize="18"
                                 Background="#FBFCFD" Foreground="#1D2939"
                                 BorderBrush="#D0D5DD" BorderThickness="1"
                                 PreviewTextInput="CustomerNumberTextBox_PreviewTextInput"
                                 GotFocus="CustomerNumberTextBox_GotFocus"
                                 LostFocus="CustomerNumberTextBox_LostFocus"/>
                        <TextBlock x:Name="PlaceholderTextBlock" Text="Kundennummer eingeben"
                                   Margin="15,0,0,0" VerticalAlignment="Center"
                                   Foreground="#98A2B3" FontSize="15"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock Text="Tätigkeit / Notiz" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,16,0,9"/>
                    <TextBox x:Name="NotesTextBox"
                             MinHeight="76" MaxHeight="120"
                             Padding="12,9"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontFamily="Calibri" FontSize="15"
                             Background="#FBFCFD" Foreground="#1D2939"
                             BorderBrush="#D0D5DD" BorderThickness="1"
                             ToolTip="Notiz wird während der Zeiterfassung automatisch gespeichert"
                             TextChanged="NotesTextBox_TextChanged"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="22"
                        BorderBrush="#E6EBF0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Erfassungsbeginn" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="StartTimeTextBlock" Text="--:--"
                                   FontFamily="Calibri" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyBrush}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="22"
                        BorderBrush="#E6EBF0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Verstrichene Zeit" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="ElapsedTimeTextBlock" Text="00:00:00"
                                   FontFamily="Consolas" FontSize="24" FontWeight="Normal"
                                   Foreground="{StaticResource NavyBrush}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Content="Start"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="StartButton_Click"/>
                <Button x:Name="PauseButton" Grid.Column="2" Content="Pause"
                        Background="#EEF2F6" Foreground="{StaticResource NavyBrush}"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="PauseButton_Click" IsEnabled="False"/>
                <Button x:Name="StopButton" Grid.Column="4" Content="Stoppen"
                        Background="#B42318" Foreground="White"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="StopButton_Click" IsEnabled="False"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
