<Window x:Class="Kronix.Windows.EmployeeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mitarbeiter" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <Border Background="White" CornerRadius="16" Padding="28"
            BorderBrush="#E5EAF0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#27364B" BlurRadius="24" ShadowDepth="5" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleTextBlock" Text="Mitarbeiter hinzufügen"
                           FontSize="21" FontWeight="SemiBold" Foreground="#1D2939"/>
                <TextBlock x:Name="SubtitleTextBlock" Text="Mitarbeiterdaten speichern"
                           FontSize="14" Foreground="#667085" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="Mitarbeiternummer" FontSize="13" FontWeight="SemiBold"
                           Foreground="#344054" Margin="0,0,0,6"/>
                <TextBox x:Name="EmployeeNumberTextBox" Height="40" Padding="11,0"
                         VerticalContentAlignment="Center" FontSize="15"
                         BorderBrush="#D0D5DD" BorderThickness="1"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vorname" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#344054" Margin="0,0,0,6"/>
                        <TextBox x:Name="FirstNameTextBox" Height="40" Padding="11,0"
                                 VerticalContentAlignment="Center" FontSize="14"
                                 BorderBrush="#D0D5DD" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nachname" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#344054" Margin="0,0,0,6"/>
                        <TextBox x:Name="LastNameTextBox" Height="40" Padding="11,0"
                                 VerticalContentAlignment="Center" FontSize="14"
                                 BorderBrush="#D0D5DD" BorderThickness="1"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="MakeCurrentCheckBox"
                          Content="Nach dem Speichern als aktuellen Mitarbeiter auswählen"
                          IsChecked="True" Margin="0,16,0,0"
                          FontSize="13" Foreground="#344054"/>
                <TextBlock x:Name="ErrorTextBlock" Foreground="#B42318"
                           FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Abbrechen" Width="112" Height="40"
                        Background="White" Foreground="#344054"
                        BorderBrush="#D0D5DD" BorderThickness="1"
                        FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button Content="Speichern" Width="112" Height="40"
                        Background="#20364F" Foreground="White"
                        BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
