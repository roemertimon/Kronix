<Window x:Class="Kronix.Windows.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="680" Width="1080"
        MinHeight="680" MinWidth="1080"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing">
    
    <DockPanel Background="#F7F9FB">
        <DockPanel.Resources>
            <Style x:Key="MenuButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#667085"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F4F7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF0F6"/>
                                    <Setter Property="Foreground" Value="#20364F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </DockPanel.Resources>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E6EBF0"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Resources/Kronix_logo_name.jpg"
                           Width="132" Height="40" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           ToolTip="Kronix"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Name="ZeiterfassungBtn" Content="Zeiterfassung"
                                MinWidth="145" Height="42"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="ZeiterfassungButton_Click"/>
                        <Button Name="KundenBtn" Content="Kunden"
                                MinWidth="145" Height="42" Margin="6,0,0,0"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="KundenButton_Click"/>
                        <Button Name="MitarbeiterBtn" Content="Mitarbeiter"
                                MinWidth="145" Height="42" Margin="6,0,0,0"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="MitarbeiterButton_Click"/>
                        <Button Name="DatenBtn" Content="Zeiteinträge"
                                MinWidth="145" Height="42" Margin="6,0,0,0"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="DatenButton_Click"/>
                        <Button Name="EinstellungenBtn" Content="Einstellungen"
                                MinWidth="145" Height="42" Margin="6,0,0,0"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="EinstellungenButton_Click"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="DatabaseWarningBorder" Grid.Row="1"
                        Background="#FFF4E5" Padding="18,8"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Datenbankproblem" FontWeight="SemiBold"
                                   Foreground="#93370D" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DatabaseWarningTextBlock"
                                   Foreground="#93370D" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContentControl" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
        
    </DockPanel>
</Window>