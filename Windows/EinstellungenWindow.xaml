<UserControl x:Class="Kronix.Windows.EinstellungenWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="EinstellungenWindow_Loaded" Unloaded="EinstellungenWindow_Unloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#20364F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#E9EEF4"/>
            <Setter Property="Foreground" Value="#20364F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#F7F9FB" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Einstellungen" FontSize="23" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}"/>
                <TextBlock Text="Datenbank, Sicherungen, Updates und Systemstatus"
                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#E6EBF0" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Aktive Datenbank" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource NavyBrush}"/>
                    <Grid Margin="0,8,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DatabasePathTextBlock" Grid.Column="0" TextWrapping="Wrap"
                                   FontSize="13" Foreground="#475467" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                                Background="#F7F9FB" BorderThickness="0" Cursor="Hand"
                                ToolTip="Datenbankdatei im Explorer anzeigen"
                                AutomationProperties.Name="Datenbankdatei im Explorer anzeigen"
                                Click="OpenDatabaseInExplorerButton_Click">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="{StaticResource NavyBrush}"/>
                        </Button>
                    </Grid>
                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,18">
                        <Border Background="#F7F9FB" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Dateigröße" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="DatabaseSizeTextBlock" Text="–" FontSize="18"
                                           FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7F9FB" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Zeiteinträge" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TimeLogCountTextBlock" Text="–" FontSize="18"
                                           FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7F9FB" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Kunden" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="CustomerCountTextBlock" Text="–" FontSize="18"
                                           FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <WrapPanel>
                        <Button Content="Datenbank auswählen" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,8" Click="SelectDatabaseButton_Click"/>
                        <Button Content="Neue leere Datenbank" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,8" Click="CreateDatabaseButton_Click"/>
                        <Button Content="Prüfen und Schema reparieren" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,8" Click="CheckDatabaseButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#E6EBF0" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Sicherung und Wiederherstellung" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                    <TextBlock Text="ZIP-Archive enthalten eine konsistente Kopie der Datenbank. Beim Wiederherstellen wird eine neue Datei angelegt; bestehende Datenbanken werden nicht überschrieben."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,14"/>
                    <WrapPanel>
                        <Button Content="Sicherung als ZIP speichern" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,8" Click="ExportArchiveButton_Click"/>
                        <Button Content="ZIP-Sicherung wiederherstellen" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,8" Click="ImportArchiveButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#E6EBF0" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Aktivitätsprotokoll" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                    <TextBlock Text="Protokolliert wichtige Aktionen und Fehler. Eingaben wie Notizen oder Kundendaten werden nicht mitgeschrieben. Eine Datei ist höchstens 1 MB groß; drei ältere Dateien werden aufbewahrt."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,10"/>
                    <TextBlock x:Name="LogPathTextBlock" TextWrapping="Wrap"
                               FontSize="12" Foreground="#475467" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Protokoll ansehen" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,0" Click="ViewLogButton_Click"/>
                        <Button Content="Protokollordner öffnen" Style="{StaticResource ActionButton}"
                                Click="OpenLogFolderButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#E6EBF0" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Tastenkombination zum Öffnen" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                    <TextBlock Text="Mit dieser Tastenkombination holst du Kronix aus dem Infobereich zurück (nochmaliges Drücken blendet es wieder aus). Sie gilt nur an diesem PC. Zum Ändern in das Feld klicken und die neue Kombination drücken."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <WrapPanel>
                        <TextBox x:Name="HotkeyTextBox" Width="240" Height="40" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Padding="10,0" FontSize="14"
                                 IsReadOnlyCaretVisible="False" Margin="0,0,8,8"
                                 AutomationProperties.Name="Tastenkombination"
                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                        <Button Content="Standard (Strg+Alt+K)" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,8" Click="ResetHotkeyButton_Click"/>
                        <Button Content="Deaktivieren" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,8" Click="DisableHotkeyButton_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="HotkeyStatusTextBlock" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#E6EBF0" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Version und Updates" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                    <TextBlock Text="Beim Öffnen der Einstellungen wird das neueste öffentliche GitHub-Release geprüft. Leer lassen, um die Prüfung zu deaktivieren."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBlock Text="GitHub-Repository (Name oder URL)" FontSize="12"
                               FontWeight="SemiBold" Foreground="#475467" Margin="0,0,0,5"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button Content="Speichern und prüfen" DockPanel.Dock="Right"
                                Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                                Click="SaveRepositoryButton_Click"/>
                        <TextBox x:Name="RepositoryTextBox" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 AutomationProperties.Name="GitHub-Repository"/>
                    </DockPanel>
                    <TextBlock x:Name="InstalledVersionTextBlock" FontSize="13" Foreground="#344054"/>
                    <TextBlock x:Name="LatestVersionTextBlock" FontSize="13" Foreground="#344054" Margin="0,4,0,0"/>
                    <TextBlock x:Name="UpdateStatusTextBlock" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,12"/>
                    <WrapPanel>
                        <Button x:Name="CheckUpdatesButton" Content="Erneut prüfen" Style="{StaticResource ActionButton}"
                                Margin="0,0,8,0" Click="CheckUpdatesButton_Click"/>
                        <Button x:Name="OpenReleaseButton" Content="GitHub-Releases öffnen" Style="{StaticResource ActionButton}"
                                IsEnabled="False" Click="OpenReleaseButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Background="#EEF7F2" CornerRadius="10"
                    Padding="14" BorderBrush="#D4EBDD" BorderThickness="1">
                <TextBlock x:Name="DatabaseStatusTextBlock" Text="Datenbankstatus wird geprüft."
                           FontSize="13" Foreground="#28704D" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
