<Window x:Class="Kronix.Windows.CustomerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kundendaten" Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <Border Background="White" CornerRadius="16" Padding="28"
            BorderBrush="#E5EAF0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#27364B" BlurRadius="24" ShadowDepth="5" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleTextBlock" Text="Kunde hinzufügen"
                           FontSize="21" FontWeight="SemiBold" Foreground="#1D2939"/>
                <TextBlock x:Name="SubtitleTextBlock" Text="Kundendaten für Kronix speichern"
                           FontSize="14" Foreground="#667085" Margin="0,6,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                    <TextBlock Text="Kundennummer" FontSize="13" FontWeight="SemiBold"
                               Foreground="#344054" Margin="0,0,0,6"/>
                    <TextBox x:Name="ClientNumberTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="15"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="Vorname" FontSize="13" FontWeight="SemiBold"
                               Foreground="#344054" Margin="0,0,0,6"/>
                    <TextBox x:Name="FirstNameTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="14"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="Nachname" FontSize="13" FontWeight="SemiBold"
                               Foreground="#344054" Margin="0,0,0,6"/>
                    <TextBox x:Name="LastNameTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="14"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="Firma / Zusatz" FontSize="13" FontWeight="SemiBold"
                               Foreground="#344054" Margin="0,0,0,6"/>
                    <TextBox x:Name="CompanyTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="14"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="Straße und Hausnummer" FontSize="13" FontWeight="SemiBold"
                               Foreground="#344054" Margin="0,0,0,6"/>
                    <TextBox x:Name="StreetTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="14"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="PLZ" FontSize="13" FontWeight="SemiBold"
                               Foreground="#344054" Margin="0,0,0,6"/>
                    <TextBox x:Name="PostalCodeTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="14"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="Ort" FontSize="13" FontWeight="SemiBold"
                               Foreground="#344054" Margin="0,0,0,6"/>
                    <TextBox x:Name="CityTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="14"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="Telefonnummer" FontSize="13" FontWeight="SemiBold"
                               Foreground="#344054" Margin="0,0,0,6"/>
                    <TextBox x:Name="PhoneNumberTextBox" Height="40" Padding="11,0"
                             VerticalContentAlignment="Center" FontSize="14"
                             BorderBrush="#D0D5DD" BorderThickness="1"/>
                </StackPanel>
                <TextBlock x:Name="ErrorTextBlock" Grid.Row="6" Grid.ColumnSpan="3"
                           Foreground="#B42318" FontSize="12" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Abbrechen" Width="112" Height="40"
                        Background="White" Foreground="#344054"
                        BorderBrush="#D0D5DD" BorderThickness="1"
                        FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button Content="Speichern" Width="112" Height="40"
                        Background="#20364F" Foreground="White"
                        BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
