<Window x:Class="Kronix.Windows.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kronix-Protokoll" Width="900" Height="600"
        MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FB" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Aktivitätsprotokoll" FontSize="20"
                       FontWeight="SemiBold" Foreground="#20364F"/>
            <TextBlock x:Name="PathTextBlock" FontSize="12"
                       Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="#D0D5DD" BorderThickness="1" Padding="8">
            <TextBox x:Name="LogTextBox" IsReadOnly="True"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     Background="White" Foreground="#344054"
                     BorderThickness="0"/>
        </Border>
        <Button Grid.Row="2" Content="Schließen" Width="110" Height="38"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="#20364F" Foreground="White"
                BorderThickness="0" FontWeight="SemiBold"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
