<Window x:Class="Kronix.Windows.AppMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kronix" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <Border Background="White" CornerRadius="16" Padding="28"
            BorderBrush="#E5EAF0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#27364B" BlurRadius="24" ShadowDepth="5" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBackground" Width="48" Height="48" CornerRadius="24"
                        Background="#FFF1F0" VerticalAlignment="Top">
                    <TextBlock x:Name="IconTextBlock" Text="&#xE783;"
                               FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="#B42318" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,1,0,0">
                    <TextBlock x:Name="TitleTextBlock" Text="Hinweis"
                               FontSize="21" FontWeight="SemiBold" Foreground="#1D2939"/>
                    <TextBlock x:Name="MessageTextBlock" Text=""
                               FontSize="14" Foreground="#667085"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
            <Button Grid.Row="1" Content="OK" Width="100" Height="40"
                    HorizontalAlignment="Right" Margin="0,24,0,0"
                    Background="#20364F" Foreground="White"
                    BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                    Click="OkButton_Click"/>
        </Grid>
    </Border>
</Window>
